# ==============================================================================
# Environment Configuration Template for Plastic Reimagined
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with secrets to source control.

# Core Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-plastic-reimagined-foundation-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Configuration
# Local development defaults to SQLite when unset or configured as:
# DATABASE_URL=sqlite:///db.sqlite3
#
# For production PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/plastic_reimagined
DATABASE_URL=sqlite:///db.sqlite3

# Security Settings (Set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
